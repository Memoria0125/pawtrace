# ===== 环境变量模板：复制为 .env 并填入真实值（.env 永远不进 git）=====

# 数据库（本地 MySQL 8.x）
DATABASE_URL="mysql://root:你的密码@localhost:3306/pawtrace"

# 服务
PORT=3000
JWT_SECRET="改成一串足够长的随机字符串"

# 腾讯云 COS（图片存储）
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION="ap-guangzhou"

# 第三方 AI 识别（密钥只存后端，绝不下发到 App）
AI_API_URL=""
AI_API_KEY=""

# 限制
AI_DAILY_LIMIT_PER_USER=50
